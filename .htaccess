# Root Apache rules for SAMS.
# The legacy public UI remains available during migration; new API traffic
# uses the centralized backend front controller.

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /sams/

    # /sams/ -> /sams/public/
    RewriteRule ^$ public/ [R=302,L]

    # Centralized API surface.
    RewriteRule ^api/v1(?:/|$) backend/public/index.php [L,QSA]

    # Never expose repository metadata or private application directories through Apache.
    RewriteRule ^(?:\.git|\.github|app|backend/(?:src|config|database|storage|scripts|tests|vendor)|config|database|storage|scripts|tests)(?:/|$) - [F,L,NC]
    RewriteRule \.(?:sql|log|env|ini|bak|old|dist)$ - [F,L,NC]
</IfModule>

<FilesMatch "^(?:\.env|.*\.sql|.*\.log|.*\.bak|.*\.old)$">
    Require all denied
</FilesMatch>
