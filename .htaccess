# Root Apache rules for SAMS when the repository is placed directly in htdocs.
# The browser is redirected to the real public directory so relative asset/API
# URLs resolve correctly. Private application directories remain blocked.

Options -Indexes

<IfModule mod_rewrite.c>
    RewriteEngine On

    # /sams/ -> /sams/public/
    RewriteRule ^$ public/ [R=302,L]

    # Never expose application internals through Apache.
    RewriteRule ^(?:app|config|database|storage|scripts|tests)(?:/|$) - [F,L,NC]
    RewriteRule \.(?:sql|log|env|ini|bak|old|dist)$ - [F,L,NC]
</IfModule>

<FilesMatch "^(?:\.env|.*\.sql|.*\.log|.*\.bak|.*\.old)$">
    Require all denied
</FilesMatch>
