{
    "name": "hm-abdellah/sams-backend",
    "description": "SAMS PHP backend",
    "type": "project",
    "require": {
        "php": "~8.3.0",
        "phpoffice/phpspreadsheet": "^5.10"
    },
    "require-dev": {
        "phpunit/phpunit": "^12.5"
    },
    "autoload": {
        "psr-4": {
            "SAMS\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "SAMS\\Tests\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {}
    },
    "scripts": {
        "test": "phpunit --configuration phpunit.xml",
        "test:unit": "phpunit --configuration phpunit.xml --testsuite unit"
    }
}
