# ================================
# SAMS - Git Ignore
# ================================

# Environment / secrets
.env
.env.*
!.env.example
config/config.php
config/database.php
backend/config/config.php
backend/config/app.php
backend/config/database.php

# Local database exports / dumps
*.sql.gz
*.dump
backups/

# Runtime / uploaded data
storage/runtime/
storage/logs/
storage/uploads/
backend/storage/runtime/
backend/storage/logs/
backend/storage/uploads/
backend/storage/avatars/

# Generated QA/test artifacts
artifacts/
playwright-report/
test-results/

# XAMPP / local server files
xampp/

# IDEs
.vscode/
.idea/
*.code-workspace

# OS files
.DS_Store
Thumbs.db
Desktop.ini

# Logs
*.log

# Temporary files
*.tmp
*.temp
~$*

# Test / coverage output
coverage/
.phpunit.result.cache

# Node tooling (only if introduced later)
node_modules/
backend/vendor/
backend/.phpunit.cache/
npm-debug.log*

# External real-school acceptance files (never commit student data)
ListEleve_*.xlsx
ListEleve_*.xls
ListEleve_*.md

